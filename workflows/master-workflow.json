      "webhookId": "lead-capture"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Extract token from body or query params\nconst token = input.token || input.query?.token || '';\n\n// Extract lead text from various input formats\nlet rawText = '';\nif (input.body) {\n  rawText = typeof input.body === 'string' ? input.body : JSON.stringify(input.body);\n} else if (input.message) {\n  rawText = input.message;\n} else if (input.html) {\n  rawText = input.html.replace(/<[^>]*>/g, ' ');\n} else {\n  rawText = JSON.stringify(input);\n}\n\nrawText = rawText.replace(/\\s+/g, ' ').trim();\n\nreturn [{ json: { token, rawText, original: input } }];"
      },
      "id": "extract-token",
      "name": "Extract Token + Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
