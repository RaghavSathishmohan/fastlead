      "id": "fetch-client",
      "name": "Fetch Client by Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const client = $input.first().json[0];\nconst extracted = $input.all()[0].json;\n\nif (!client) {\n  return [{ json: { error: 'Client not found for token: ' + extracted.token } }];\n}\n\nreturn [{\n  json: {\n    client_id: client.id,\n    owner_email: client.owner_email,\n    company_name: client.company_name,\n    token: client.token,\n    rawText: extracted.rawText\n  }\n}];"
      },
      "id": "enrich-client",
      "name": "Enrich with Client Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst prompt = `You are a lead extraction parser for a construction company. Extract the following fields from the input text and return ONLY a JSON object with these keys: name, phone, email, service, city, urgency.\\n\\nurgency should be one of: low, medium, high. Infer urgency from phrases like \"ASAP\", \"urgent\", \"emergency\" (high), \"soon\", \"this week\" (medium), or general inquiries (low).\\n\\nIf a field is not found, use null. Return valid JSON only, no markdown.\\n\\nInput text to parse:\\n${data.rawText}`;\n\nreturn [{ json: { ...data, prompt } }];"
      },
      "id": "build-prompt",
      "name": "Build Gemini Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "key", "value": "AIzaSyDZmEu2H7hD5hSYtf-hhi3n6DUhIBPmHSo" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "=\"{\\\"contents\\\": [{\\\"role\\\": \\\"user\\\", \\\"parts\\\": [{\\\"text\\\": \\\"{{ $json.prompt }}\\\"}]}], \\\"generationConfig\\\": {\\\"temperature\\\": 0.1}}\""
      },
      "id": "gemini-parse",
      "name": "Gemini AI Parser",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "const parsed = $input.first().json;\nconst clientData = $input.all()[1]?.json || {};\n\nlet lead = {};\ntry {\n  const text = parsed.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n  lead = JSON.parse(text);\n} catch (e) {\n  const text = JSON.stringify(parsed);\n  lead = {\n    name: text.match(/Name:\\s*([^\\n]+)/)?.[1]?.trim() || text.match(/([A-Z][a-z]+\\s+[A-Z][a-z]+)/)?.[1] || null,\n    phone: text.match(/(1?[-\\s.]?(\\([0-9]{3}\\)|[0-9]{3})[-\\s.]?[0-9]{3}[-\\s.]?[0-9]{4})/)?.[1] || null,\n    email: text.match(/([\\w.-]+@[\\w.-]+\\.[\\w]+)/)?.[1] || null,\n    service: text.match(/Service:\\s*([^\\n]+)/)?.[1]?.trim() || null,\n    city: text.match(/City:\\s*([^\\n]+)/)?.[1]?.trim() || null,\n    urgency: text.match(/Urgency:\\s*([^\\n]+)/)?.[1]?.trim()?.toLowerCase() || 'medium'\n  };\n}\n\nconst phoneRegex = /^1?[-\\s.]?(\\([0-9]{3}\\)|[0-9]{3})[-\\s.]?[0-9]{3}[-\\s.]?[0-9]{4}$/;\nconst emailRegex = /^[^\\s]+@[^\\s]+\\.[^\\s]+$/;\n\nconst validated = {\n  client_id: clientData.client_id,\n  owner_email: clientData.owner_email,\n  company_name: clientData.company_name,\n  token: clientData.token,\n  name: lead.name || 'Unknown',\n  phone: phoneRegex.test(lead.phone) ? lead.phone : null,\n  email: emailRegex.test(lead.email) ? lead.email : null,\n  service: lead.service || 'General Inquiry',\n  city: lead.city || 'Unknown',\n  urgency: ['low','medium','high'].includes(lead.urgency) ? lead.urgency : 'medium',\n  raw_input: clientData.rawText\n};\n\nreturn [{ json: validated }];"
      },
